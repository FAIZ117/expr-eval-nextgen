{
  "name": "expr-eval-nextgen",
  "version": "2.1.0",
  "description": "Mathematical expression evaluator \u2014 hardened fork (CVE-2025-13204, CVE-2025-12735, CVE-2026-12866 closed; scope functions preserved; parse-time checks, no eval-time overhead)",
  "main": "dist/bundle.js",
  "module": "dist/index.mjs",
  "typings": "parser.d.ts",
  "directories": {
    "test": "test"
  },
  "dependencies": {},
  "devDependencies": {
    "eslint": "^6.3.0",
    "eslint-config-semistandard": "^15.0.0",
    "eslint-config-standard": "^13.0.1",
    "eslint-plugin-import": "^2.15.0",
    "eslint-plugin-node": "^9.2.0",
    "eslint-plugin-promise": "^4.0.1",
    "eslint-plugin-standard": "^4.0.0",
    "mocha": "^6.2.0",
    "nyc": "^14.1.1",
    "rollup": "^1.20.3",
    "rollup-plugin-uglify": "^6.0.3"
  },
  "scripts": {
    "test": "npm run build && mocha",
    "coverage": "npm run build && nyc --reporter=lcov --reporter=text-summary mocha",
    "lint": "eslint index.js src test rollup.config.js rollup-min.config.js",
    "watch": "rollup -c rollup.config.js -w",
    "build": "rollup -c rollup.config.js && rollup -c rollup-min.config.js && rollup -c rollup-esm.config.js",
    "prepare": "npm run build"
  },
  "files": [
    "dist/",
    "parser.d.ts",
    "LICENSE.txt"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/faiz/expr-eval-nextgen.git"
  },
  "keywords": [
    "expr-eval",
    "expression",
    "evaluator",
    "math",
    "parser",
    "formula",
    "sandboxed",
    "nextgen"
  ],
  "author": "Matthew Crumley",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/silentmatt/expr-eval/issues"
  },
  "homepage": "https://github.com/silentmatt/expr-eval#readme",
  "exports": {
    ".": {
      "types": "./parser.d.ts",
      "require": "./dist/bundle.js",
      "import": "./dist/index.mjs",
      "default": "./dist/bundle.js"
    }
  }
}